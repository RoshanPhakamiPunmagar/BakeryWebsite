@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5 mb-4">
    <h1 class="display-4">Welcome to Pasticceria Papa!</h1>
    <p class="display-10">Explore our range of bakery items that our customers love the most. Each product is crafted with care and tradition, ensuring you experience the best of our bakery.</p>
</div>

<div class="container mt-4">
   
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#">Pasticceria Papa</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Home Page</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("AboutUs", "About")">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Contact", "Home")">Contact</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("References", "Home")">References</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Catalogue")" role="button">View Catalogue</a>
                </li>
            </ul>
        </div>
    </nav>


<div id="carouselExampleIndicators" class="carousel slide mt-4">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>
    <div class="carousel-inner">
       
        <div class="carousel-item active">
            <img src="/images/PapaLogo.png" class="d-block w-100" alt="Pasticceria Papa Logo" style="max-height: 400px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block">
                <h5>Pasticceria Papa</h5>
                <p>Our brand logo, representing our commitment to quality and tradition.</p>
            </div>
        </div>
        
        <div class="carousel-item">
            <img src="/images/brioche.jpg" class="d-block w-100" alt="Brioche" style="max-height: 400px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block">
                <h5>Fresh Brioche</h5>
                <p>Our brioche is a customer favorite, made fresh daily.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="/images/danish.jpg" class="d-block w-100" alt="Danish Pastry" style="max-height: 400px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block">
                <h5>Danish Pastry</h5>
                <p>A delightful treat with rich, buttery layers.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="/images/croissantscrolls.jpg" class="d-block w-100" alt="Croissant Scrolls" style="max-height: 400px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block">
                <h5>Croissant Scrolls</h5>
                <p>Perfectly flaky and sweet, these scrolls are a hit.</p>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

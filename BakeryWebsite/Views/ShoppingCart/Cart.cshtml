@model List<BakeryWebsite.Models.CartItem>

<h2>Shopping Cart</h2>

@if (Model == null || Model.Count == 0)
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 50px;" />
                        @item.Product.Name
                    </td>
                    <td>@String.Format("{0:C}", item.Product.Price)</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:C}", item.Product.Price * item.Quantity)</td>
                    <td>
                        <form asp-action="RemoveFromCart" asp-route-productId="@item.Product.Id" method="post">
                            <button type="submit" class="btn btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p><strong>Total: @String.Format("{0:C}", ViewBag.TotalPrice)</strong></p>

    <div>
        <a asp-controller="Catalogue" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
        <a asp-action="ClearCart" class="btn btn-warning">Clear Cart</a>
        <a asp-action="Checkout" class="btn btn-success">Checkout</a> <!-- For future checkout functionality -->
    </div>
}

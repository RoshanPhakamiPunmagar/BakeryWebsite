@{
    ViewData["Title"] = "About Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>About Us | Pasticceria Papa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: skyblue; 
        }

        .navbar {
            background-color: #007bff; 
        }

        .navbar-brand, .nav-link {
            color: white !important; 
        }

        .container {
            margin-top: 40px; 
        }

        .text-center h1 {
            color: #007bff; 
        }

        .text-center p {
            color: #6c757d; 
        }

        h2 {
            color: #343a40; 
            margin-top: 30px; 
        }

        p {
            color: #555; 
            line-height: 1.6; 
        }

        .footer {
            margin-top: 50px; 
            background-color: #007bff; 
            color: white; 
            padding: 20px; 
            text-align: center; 
        }
    </style>
</head>
<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="#">Pasticceria Papa</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Home Page</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="@Url.Action("AboutUs", "About")">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Contact", "Home")">Contact</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("References", "Home")">References</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Catalogue")">View Catalogue</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="text-center mb-5">
            <h1 class="display-5">About Pasticceria Papa</h1>
            <p class="lead">Our Story, Tradition, and Passion for Baking</p>
        </div>

        <div class="col-md-8 mx-auto">
            <h2>Our Journey</h2>
            <p>
                Founded in 1985, Pasticceria Papa began as a small family bakery. With a blend of traditional Italian techniques and dedication, we've grown into a beloved local spot for fresh pastries, cakes, and bread made from the finest ingredients (Source: Pasticceria Papa, 2023).
            </p>

            <h2>Our Values</h2>
            <p>
                We pride ourselves on quality, tradition, and community. Our recipes honor Italian baking traditions, and we strive to be a cherished part of our community (Source: Pasticceria Papa, 2023).
            </p>

            <h3>Our Mission</h3>
            <p>
                Our mission is to bake with love, celebrate tradition, and bring joy to every customer who visits us (Source: Pasticceria Papa, 2023).
            </p>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2024 Pasticceria Papa. All Rights Reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

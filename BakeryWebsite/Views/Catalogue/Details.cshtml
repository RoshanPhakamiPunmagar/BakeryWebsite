@model BakeryWebsite.Models.Product

<h2>@Model.Name</h2>

<div>
    <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" style="width: 200px; height: auto;" />
    <p>@Model.Description</p>
    <h4>@Model.Price.ToString("c")</h4>
    <p><strong>Category:</strong> @Model.Category</p>

    <!-- Back to Catalogue Button -->
    <a href="@Url.Action("Index", "Catalogue", new { category = ViewBag.CurrentCategory, productPage = ViewBag.CurrentPage })" class="btn btn-primary">Back to Catalogue</a>
</div>

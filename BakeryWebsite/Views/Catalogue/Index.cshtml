@model IEnumerable<BakeryItem>
@{
    ViewData["Title"] = "Catalogue";
}

<h1>Our Bakery Items</h1>
<ul>
    @foreach (var item in Model)
    {
        <li>
            <img src="@item.ImageUrl" alt="@item.Name" style="max-width: 300px; height: auto;" />
            <h2>@item.Name</h2>
            <p>@item.Description</p>
            <p>@item.Price.ToString("C")</p>

            @* Check if the item is a Strawberry Cheese Cake and add the reference *@
            @if (item.Name == "Strawberry Cheese Cake")
            {
                <p>
                    Unknown (n.d.) <i>Strawberry Cheese Cakes</i>. [Online]. Available at:
                    <a href="https://cdn.shopify.com/s/files/1/1373/1921/products/Crosstown-Diner-Cheesecakes-18.jpg?v=1469716956" target="_blank">
                        https://cdn.shopify.com/s/files/1/1373/1921/products/Crosstown-Diner-Cheesecakes-18.jpg?v=1469716956
                    </a> (Accessed: 12 August 2024).
                </p>
            }
        </li>
    }
</ul>
